{
  "name": "@concord/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../infra/.env --watch --import tsx src/index.ts",
    "start": "node --env-file-if-exists=../../infra/.env --import tsx src/index.ts",
    "user:add": "node --env-file-if-exists=../../infra/.env --import tsx scripts/user-add.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@concord/shared": "workspace:*",
    "@fastify/cors": "11.3.1",
    "@fastify/rate-limit": "11.2.1",
    "fastify": "5.12.5",
    "livekit-server-sdk": "2.19.1",
    "tsx": "4.23.15",
    "youtubei.js": "18.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5"
  }
}
