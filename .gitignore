node_modules/
dist/
out/
release/
coverage/
*.log
.DS_Store

# secrets — never commit
.env
.env.*
!.env.example
infra/users.json
# written by the api (Discord names, avatars, nicknames)
infra/profiles.json
infra/profiles.json.*
# written by the api in dev: jam audio cache (read by the jam bot) and the rooms' jam queues
infra/jam-cache/
infra/jam-state.json
infra/jam-state.json.*

# jam bot (Go) build output; apps/jam-bot/dist/ (the binary the deploy sends to the VM) is
# already covered by dist/ above
apps/jam-bot/bin/
apps/jam-bot/jam-bot
apps/jam-bot/*.exe
apps/jam-bot/*.test
apps/jam-bot/*.out

# web app build on the VM (web/current, bind-mounted into Caddy); the deploy puts it there.
# The local build output (apps/desktop/out/web) is already covered by out/ above.
/web/

# Terraform state and local variables can contain infrastructure identifiers or credentials.
infra/terraform/.terraform/
infra/terraform/*.tfstate
infra/terraform/*.tfstate.*
infra/terraform/*.tfvars
infra/terraform/*.tfvars.json
infra/terraform/crash.log

# infra/local (hospedagem local no Windows): binario baixado, PIDs e logs
infra/local/bin/
infra/local/.pids
infra/local/*.log
